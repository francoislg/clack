# Optional per-instance image overlay — NOT committed, NOT built by default.
#
# Copy to data/docker/Dockerfile.custom (gitignored) to layer instance-specific
# installs into the pinned tools image. When that file exists,
# scripts/gce-deploy.sh builds the generic tools image as
# `clack:tools-base`, then builds this overlay (build context: data/docker/) and
# pushes IT as `clack:tools`; the app image then builds FROM `clack:tools`.
# Without the file, `clack:tools` is just the generic tools image — zero-config
# instances are unaffected. The overlay is rebuilt only when tools inputs change
# (this file, or anything under data/docker/), not on every code deploy.
#
# Use this for things the persistent data disk can't carry: OS packages
# (`apk add`), dynamically-linked binaries, anything that needs root at install
# time. For hook scripts / static binaries, prefer `data/worker-hooks/` on the
# data disk (see docs/worker-settings.md). The worker settings file needs
# NEITHER — `data/worker-settings.json` reaches the VM through
# scripts/gce-push.sh.
#
# This layers on the BARE tools base — it is root and has no `clack` user yet
# (the app stage creates that user and ends on `USER clack`). So stay root here
# and do NOT add a `USER clack` switch; it would fail (no such user).
#
# Replace REGION and PROJECT_ID with your instance's values — the deploy script
# prints the exact image path it pushes (e.g.
# `us-central1-docker.pkg.dev/example-project/clack/clack:tools-base`).
FROM REGION-docker.pkg.dev/PROJECT_ID/clack/clack:tools-base

# Example: install OS packages your worker hooks depend on
# RUN apk add --no-cache jq ripgrep

# Example: bake a hook implementation into the image at a fixed absolute path.
# Files must live inside data/docker/ — this directory is the build context.
# COPY my-hook/ /opt/worker-hooks/my-hook/
# RUN chmod +x /opt/worker-hooks/my-hook/hook.sh
