# Settings for the scripts/gce-*.sh deploy and sync scripts.
#
# Copy this file to data/gce.env (gitignored) and fill in your instance's values.
# One KEY=value per line; an environment variable of the same name overrides the
# file. The values below are examples, not defaults.

# Required: the VM's zone. The Artifact Registry region is derived from it
# (e.g. zone us-central1-a -> registry region us-central1).
GCE_ZONE=us-central1-a

# Required by `scripts/gce-deploy.sh --provision` only: the source ranges the SSH
# firewall rule admits. Every script connects through Identity-Aware Proxy, so set
# this to IAP's TCP-forwarding range, listed in Google's IAP documentation
# ("Using IAP for TCP forwarding" → "Create a firewall rule").
GCE_SSH_SOURCE_RANGES=

# Optional: the VM name (default: clack).
# GCE_INSTANCE=clack

# Optional: the Artifact Registry Docker repository (default: clack).
# GCE_AR_REPO=clack

# Optional: the GCP project (default: `gcloud config get-value project`).
# GCE_PROJECT=example-project

# Optional: the VM machine type used at provisioning (default: e2-standard-2).
# GCE_MACHINE_TYPE=e2-standard-2
