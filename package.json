{
  "name": "clack",
  "version": "1.0.0",
  "description": "Clack - Slack bot that answers codebase questions using Claude Code",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:logfile": "mkdir -p logs && node dist/index.js 2>&1 | tee \"logs/clack-$(date +%Y%m%d-%H%M%S).log\"",
    "dev": "tsc --watch & node --watch dist/index.js",
    "test": "LOG_LEVEL=silent vitest run",
    "ask": "npx tsx scripts/askClaude.ts",
    "manifest": "npx tsx scripts/generate-manifest.ts",
    "docker-setup": "bash scripts/docker-setup.sh",
    "deploy:gce": "bash scripts/gce-deploy.sh",
    "lint": "oxlint --deny-warnings src/",
    "lint:fix": "oxlint --fix --deny-warnings src/",
    "format": "oxfmt src/",
    "format:check": "oxfmt --check src/"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.276",
    "@anthropic-ai/sdk": "^0.126.0",
    "@giphy/js-fetch-api": "^5.8.0",
    "@google/genai": "^2.23.0",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.1",
    "@slack/bolt": "^5.1.0",
    "@slack/types": "^3.1.0",
    "@slack/web-api": "^8.1.1",
    "cron-parser": "^5.10.1",
    "dotenv": "^17.4.2",
    "mmdb-lib": "^3.0.3",
    "simple-git": "^3.36.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^22.20.3",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
