{
  "name": "clack",
  "version": "1.0.0",
  "description": "Clack - Slack bot that answers codebase questions using Claude Code",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:logfile": "mkdir -p logs && node dist/index.js 2>&1 | tee \"logs/clack-$(date +%Y%m%d-%H%M%S).log\"",
    "dev": "tsc --watch & node --watch dist/index.js",
    "test": "LOG_LEVEL=silent vitest run",
    "ask": "npx tsx scripts/askClaude.ts",
    "manifest": "npx tsx scripts/generate-manifest.ts",
    "docker-setup": "bash scripts/docker-setup.sh",
    "deploy:gce": "bash scripts/gce-deploy.sh",
    "lint": "oxlint --deny-warnings src/",
    "lint:fix": "oxlint --fix --deny-warnings src/",
    "format": "oxfmt src/",
    "format:check": "oxfmt --check src/"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.118",
    "@giphy/js-fetch-api": "^5.8.0",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^22.0.1",
    "@slack/bolt": "^4.1.0",
    "@slack/types": "^2.20.0",
    "@slack/web-api": "^7.14.1",
    "cron-parser": "^5.5.0",
    "dotenv": "^17.2.3",
    "simple-git": "^3.27.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "lefthook": "^2.1.4",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
